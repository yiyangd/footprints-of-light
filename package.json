{
  "name": "footprints-of-light",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "《光之踪迹》Footprints of Light 正式工程（Vite + TypeScript + Three.js）。主页在 home/，最早的小样在 prototype/。",
  "scripts": {
    "dev": "vite",
